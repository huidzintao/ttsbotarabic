services:
  - type: web
    name: tts-bot
    runtime: docker
    plan: free
    region: frankfurt
    dockerfilePath: ./Dockerfile
    envVars:
      - key: TG_TOKEN
        sync: false
      - key: GEMINI_API_KEY
        sync: false
      - key: SERVICE_URL
        sync: false
      - key: TTS_MODEL
        value: gemini-2.5-flash-preview-tts
